{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/payment-health", "destination": "/api/payment-health" },
    { "source": "/api/functions/wavespeed-models", "destination": "/api/wavespeed-models-secure" },
    { "source": "/api/functions/wavespeed-generate", "destination": "/api/wavespeed-generate-secure" },
    { "source": "/api/data", "destination": "/api/data-secure" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
