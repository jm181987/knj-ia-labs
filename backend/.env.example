# PostgreSQL connection (server-side only; never expose in VITE_* variables)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=false

# Authentication
APP_JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=jorgitom18@gmail.com
ADMIN_PASSWORD=replace-at-deploy-time

# Public URL of this backend, used for generated storage URLs and webhooks
PUBLIC_API_URL=https://api.example.com
FRONTEND_URL=https://example.com

# Existing provider secrets; move these from Supabase secrets into this backend
WAVESPEED_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
OPENAI_API_KEY=

# Optional server port for Coolify / Docker
PORT=3000
