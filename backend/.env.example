# PostgreSQL connection (server-side only; never expose in VITE_* variables)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=false
DB_POOL_MAX=10

# Authentication
APP_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=604800
ADMIN_EMAIL=jorgitom18@gmail.com
ADMIN_PASSWORD=replace-at-deploy-time
ADMIN_PASSWORD_FORCE=false

# Only for a deliberate first clean bootstrap:
# CLEAN_START=true
# CONFIRM_CLEAN_START=DELETE_BUSINESS_DATA

# Canonical production URLs / CORS
PUBLIC_API_URL=https://knjpro.site
FRONTEND_URL=https://knjpro.site
CORS_ORIGINS=https://knjpro.site

# Provider secrets (server-side only)
WAVESPEED_API_KEY=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
# Register this production webhook URL in Mercado Pago:
# https://knjpro.site/api/functions/mp-webhook
# Secret generated in Mercado Pago > Tus integraciones > Webhooks
MERCADOPAGO_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
# Register this production webhook URL in the SAME PayPal Live app:
# https://knjpro.site/api/functions/paypal-webhook
# Webhook ID from that same PayPal Live/Sandbox app selected above
PAYPAL_WEBHOOK_ID=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Equipo
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
ADMIN_WHATSAPP=59893867429
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
LOVABLE_API_KEY=

# Standalone/Coolify server
PORT=3000
