# PostgreSQL connection (server-side only; never expose in VITE_* variables)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DB_SSL=false
DB_POOL_MAX=10

# Authentication
APP_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=604800
ADMIN_EMAIL=jorgitom18@gmail.com
ADMIN_PASSWORD=replace-at-deploy-time
ADMIN_PASSWORD_FORCE=false

# Only for a deliberate first clean bootstrap:
# CLEAN_START=true
# CONFIRM_CLEAN_START=DELETE_BUSINESS_DATA

# URLs / CORS
PUBLIC_API_URL=https://app.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Provider secrets (server-side only)
WAVESPEED_API_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Secret generated in Mercado Pago > Tus integraciones > Webhooks
MERCADOPAGO_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
# Webhook ID from the SAME PayPal Live/Sandbox app selected above
PAYPAL_WEBHOOK_ID=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Equipo
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
ADMIN_WHATSAPP=59893867429
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
LOVABLE_API_KEY=

# Standalone/Coolify server
PORT=3000
